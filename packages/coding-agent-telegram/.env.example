# ==========================================
# Prime Agent Telegram Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. Whitelist Telegram Numeric User ID from @userinfobot (Required for security)
# Bisa satu ID atau beberapa ID dipisahkan koma: "123456789,987654321"
TELEGRAM_ALLOWED_USER_ID="123456789"

# 3. URL API Prime Agent (Default: http://127.0.0.1:4677)
# Jika bot berada di mesin terpisah, arahkan ke IP/Domain server Anda
PRIME_AGENT_API_URL="http://127.0.0.1:4677"

# 4. Token Rahasia Prime Agent API (Opsional)
# Jika dikosongkan, bot akan otomatis membaca dari ~/.prime/agent/prime-agent-api/gateway.json
PRIME_AGENT_API_TOKEN=""

# 5. Konfigurasi Voice Note Whisper STT (Opsional)
# Diperlukan jika ingin mengirim perintah suara (Voice Memo)
OPENAI_API_KEY=""
# WHISPER_API_KEY=""
# WHISPER_API_BASE_URL="https://api.openai.com/v1"
