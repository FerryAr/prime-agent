{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "../coding-agent/src/index.ts"
      ],
      "@earendil-works/pi-coding-agent/*": [
        "../coding-agent/src/*"
      ],
      "@earendil-works/pi-agent-core": [
        "../agent/src/index.ts"
      ],
      "@earendil-works/pi-agent-core/*": [
        "../agent/src/*"
      ],
      "@earendil-works/pi-ai": [
        "../ai/src/index.ts"
      ],
      "@earendil-works/pi-ai/*": [
        "../ai/src/*"
      ],
      "@earendil-works/pi-tui": [
        "../tui/src/index.ts"
      ],
      "@earendil-works/pi-tui/*": [
        "../tui/src/*"
      ],
      "@earendil-works/prime-agent-api": [
        "../coding-agent-api/src/index.ts"
      ],
      "@earendil-works/prime-agent-api/*": [
        "../coding-agent-api/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.d.ts",
    "src/**/*.d.ts",
    "test"
  ]
}